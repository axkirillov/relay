{
  "name": "relay",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "bin": {
    "relay": "dist/relay.js"
  },
  "scripts": {
    "build": "node build.mjs",
    "check": "tsc --noEmit",
    "test": "for t in ui/src/*.test.ts src/*.test.ts; do echo \"— $t\"; node --no-warnings \"$t\" || exit 1; done",
    "smoke": "bash scripts/smoke.sh",
    "smoke:pty": "bash scripts/pty.sh",
    "smoke:goto": "bash scripts/goto.sh",
    "smoke:queue": "bash scripts/queue.sh",
    "smoke:dismiss": "bash scripts/dismiss.sh",
    "smoke:latch": "bash scripts/latch.sh"
  },
  "dependencies": {
    "@codemirror/commands": "^6.9.0",
    "@codemirror/lang-css": "^6.3.1",
    "@codemirror/lang-go": "^6.0.1",
    "@codemirror/lang-html": "^6.4.12",
    "@codemirror/lang-javascript": "^6.2.5",
    "@codemirror/lang-json": "^6.0.2",
    "@codemirror/lang-markdown": "^6.5.2",
    "@codemirror/lang-python": "^6.2.1",
    "@codemirror/lang-rust": "^6.0.2",
    "@codemirror/lang-sql": "^6.10.0",
    "@codemirror/lang-xml": "^6.1.0",
    "@codemirror/lang-yaml": "^6.1.3",
    "@codemirror/language": "^6.11.3",
    "@codemirror/legacy-modes": "^6.5.3",
    "@codemirror/state": "^6.5.2",
    "@codemirror/view": "^6.43.8",
    "@lezer/highlight": "^1.2.1",
    "@replit/codemirror-vim": "^6.4.0",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "diff": "^8.0.2",
    "electron": "^43.3.0",
    "node-pty": "^1.1.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "electron",
      "node-pty"
    ]
  },
  "devDependencies": {
    "@types/node": "^24.3.0",
    "esbuild": "^0.28.2",
    "typescript": "^5.9.2"
  }
}
